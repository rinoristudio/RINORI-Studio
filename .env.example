# Copy this file to .env for local development (Render uses its dashboard instead).

# Neon: Dashboard -> your project -> Connect -> copy the connection string
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full

# The admin login is NOT set here. Create or reset it with:
#   npm run set-admin -- you@example.com

# Razorpay: Dashboard -> Account & Settings -> API Keys (use rzp_test_ keys to try it out)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Optional but recommended: the secret you set on the webhook (see README)
RAZORPAY_WEBHOOK_SECRET=
